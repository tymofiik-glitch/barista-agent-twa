+let STOP_LIST = new Set(); // posterId numbers that are unavailable
+
+async function fetchStopList() {
+  try {
+    const ctrl = new AbortController();
+    const timer = setTimeout(() => ctrl.abort(), 4000);
+    // Use GitHub API (not raw CDN) — always returns fresh data, no cache delay
+    const url = 'https://api.github.com/repos/tymofiik-glitch/barista-agent-twa/contents/stop_list.json';
+    const res = await fetch(url, {
+      signal: ctrl.signal,
+      headers: { 'Accept': 'application/vnd.github.v3.raw' }
+    });
+    clearTimeout(timer);
+    if (res.ok) {
+      const data = await res.json();
+      STOP_LIST = new Set((data.stopped || []).map(Number));
+    }
+  } catch (e) {
+    STOP_LIST = new Set();
+  }
+}
+
+function refreshStopListUI() {
+  // Re-render only cards that changed state — no full re-render
+  MENU.forEach(p => {
+    const el = document.getElementById('prod_' + p.id);
+    if (!el) return;
+    const stopped = isStoppedProduct(p);
+    const wasStopped = el.classList.contains('product-stopped');
+    if (stopped === wasStopped) return;
+    // State changed — replace just this card
+    const tmp = document.createElement('div');
+    tmp.innerHTML = renderProductCard(p);
+    el.replaceWith(tmp.firstElementChild);
+  });
+  // Also refresh recom row
+  renderRecom();
+}
+
+function isStoppedProduct(p) {
+  if (p.posterId && STOP_LIST.has(Number(p.posterId))) return true;
+  // If product has a required single-choice mod group and ALL options are stopped → product itself stopped
+  if (p.modGroups && p.modGroups.length) {
+    for (const g of p.modGroups) {
+      if (g.required && g.type === 'single' && g.options && g.options.length) {
+        const allStopped = g.options.every(o => o.posterId && STOP_LIST.has(Number(o.posterId)));
+        if (allStopped) return true;
+      }
+    }
+  }
+  return false;
+}
 
